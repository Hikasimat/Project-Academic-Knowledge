# Plus UAE x Vortexen AI Sales Academy Environment Configuration

# Application settings
APP_NAME="Plus UAE × Vortexen AI Sales Academy"
ENVIRONMENT="development"
DEBUG=True

# Security secrets (Use a secure, randomly generated string in production)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
INVITATION_EXPIRE_HOURS=72

# Database configuration (SQLite for local dev, PostgreSQL for production)
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/plusuae_academy
DATABASE_URL="sqlite:///./sales_academy.db"

# CORS configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Rate limiting settings
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
